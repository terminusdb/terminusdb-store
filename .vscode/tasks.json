{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "test-coverage",
        "type": "shell",
        "command": "cargo",
        "args": [
          "llvm-cov",
          "nextest",
          "--lcov",
          "--output-path",
          "./lcov.info"
        ],
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      }
    ]
}
